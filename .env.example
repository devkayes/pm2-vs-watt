# Copy to .env and fill in. Used by scripts/run-all.sh and the monitoring stack.

# Private IP of the app VM. Leave empty to run everything on this machine.
APP_HOST=
# SSH user on the app VM.
APP_USER=ubuntu
# Where Prometheus runs. Leave empty to skip Grafana.
PROM_URL=http://localhost:9090

# Test settings (about 20 minutes). ka = keep-alive, new = new connection per request.
MODES=ka
REPEATS=2
WARMUP=20s
DURATION=70s
